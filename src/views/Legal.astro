---
import Base from "@/layouts/Base.astro";
import { useTranslations, type Lang } from "@/i18n/ui";
import type { MarkdownInstance } from "astro";

interface Props {
  lang: Lang;
  doc: "privacy" | "terms";
}
const { lang, doc } = Astro.props;
const t = useTranslations(lang);

type Frontmatter = { updated: string };
const docs = import.meta.glob<MarkdownInstance<Frontmatter>>("../content/legal/*/*.md", { eager: true });
const page = docs[`../content/legal/${lang}/${doc}.md`];
if (!page) throw new Error(`missing legal page ${lang}/${doc}`);
const { Content, frontmatter } = page;
const headings = page.getHeadings().filter((h) => h.depth === 2);
const updated = new Intl.DateTimeFormat(lang === "es" ? "es-EC" : "en-US", { dateStyle: "long", timeZone: "UTC" }).format(
  new Date(frontmatter.updated),
);
---

<Base lang={lang} path={`/money/${doc}`} title={t(`${doc}.title`)} description={t(`${doc}.description`)}>
  <article class="mx-auto max-w-3xl px-4 sm:px-6 pt-12 sm:pt-16">
    <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-balance">{t(`${doc}.title`)}</h1>
    <p class="mt-3 text-sm text-muted">{t("legal.updated")}: <time datetime={frontmatter.updated}>{updated}</time></p>

    <nav aria-labelledby="toc" class="mt-8 rounded-2xl bg-surface-low border border-divider p-5">
      <h2 id="toc" class="text-sm font-semibold">{t("legal.contents")}</h2>
      <ol class="mt-3 grid gap-1.5 text-sm text-ink-soft sm:grid-cols-2 list-decimal pl-5">
        {headings.map((h) => <li><a class="hover:text-ink underline-offset-2 hover:underline" href={`#${h.slug}`}>{h.text.replace(/^\d+\.\s*/, "")}</a></li>)}
      </ol>
    </nav>

    <div class="prose-legal mt-4">
      <Content />
    </div>
  </article>
</Base>
