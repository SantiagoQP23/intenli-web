---
import Base from "@/layouts/Base.astro";
import Logo from "@/components/Logo.astro";
import { localePath, useTranslations, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Base lang={lang} path="/" title={t("home.title")} description={t("home.description")} product="intenli">
  <section class="mx-auto max-w-5xl px-4 sm:px-6 pt-16 sm:pt-28 flex flex-col gap-6">
    <h1 class="text-4xl sm:text-6xl font-semibold tracking-tight leading-[1.05] max-w-3xl text-balance">{t("home.heading")}</h1>
    <p class="text-lg text-ink-soft leading-8 max-w-2xl">{t("home.lead")}</p>
  </section>

  <section class="mx-auto max-w-5xl px-4 sm:px-6 mt-16">
    <a
      href={localePath(lang, "/money")}
      class="group rounded-3xl bg-surface-low border border-divider p-6 sm:p-8 flex flex-col gap-6 sm:flex-row sm:items-center hover:border-border"
    >
      <Logo class="size-28 shrink-0" />
      <div class="flex flex-col gap-2">
        <h2 class="text-2xl font-semibold tracking-tight">{t("home.moneyTitle")}</h2>
        <p class="text-ink-soft leading-7 max-w-xl">{t("home.moneyText")}</p>
        <span class="mt-2 font-semibold underline underline-offset-4 group-hover:no-underline">{t("home.moneyCta")} →</span>
      </div>
    </a>
  </section>
</Base>
