---
// The piggy-bank logo, inline so it follows the color scheme: lines take the
// text color and the coin the theme's coin blue.
import logo from "@/assets/brand/logo.svg?raw";
import mark from "@/assets/brand/mark.svg?raw";

interface Props {
  variant?: "logo" | "mark";
  class?: string;
  title?: string;
}
const { variant = "logo", class: className = "", title } = Astro.props;
const raw = variant === "mark" ? mark : logo;
const svg = raw
  .replace('fill="#1C1B19"', 'fill="currentColor"')
  .replace('fill="#DCE7EE"', 'fill="var(--c-coin)"')
  .replace('fill="#FFFFFF"', 'fill="var(--c-bg)"')
  .replace(
    "<svg ",
    title
      ? `<svg role="img" aria-label="${title}" class="${className}" `
      : `<svg aria-hidden="true" focusable="false" class="${className}" `,
  );
---

<Fragment set:html={svg} />
